NODE_ENV=development
PORT=4400
APP_URL=http://localhost:4400
# DarkGallery frontend (apps/gallery). Trusted for CORS and as a
# post-login redirect target, same as WEB_URL.
GALLERY_URL=http://localhost:4300
WEB_URL=http://localhost:5173

# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/darkdrive?schema=public"

# Redis (used for sessions + pub/sub)
REDIS_URL="redis://localhost:6379"

# Session
SESSION_SECRET="change-me-to-a-long-random-string"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4400/api/auth/google/callback"

# Local storage root
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=2048

# --- Optional (set only when you need them) ---------------------------------

# Scope the session cookie across all subdomains of your registered domain.
# Recommended in production when web + api live on different subdomains.
# Example: COOKIE_DOMAIN=.darkdrive.zenux.live
# COOKIE_DOMAIN=

# Extra origins the API should accept on top of WEB_URL. Comma-separated.
# Useful for www + apex, staging previews, or a secondary admin site.
# Example: ALLOWED_ORIGINS=https://www.darkdrive.zenux.live,https://staging.darkdrive.zenux.live
# ALLOWED_ORIGINS=

# Enables POST /api/auth/dev-login — a password-less "log in by email" route
# for local development, so you don't have to wire up Google OAuth just to
# test the app. Logs you in as any email, creating the user if it doesn't
# exist yet — never point this at a database containing real user data.
# Only takes effect when NODE_ENV=development (exactly that value; ignored
# under "test" or "production"). Must be the literal string "true" — any
# other value, including "false", is treated as disabled.
ENABLE_DEV_LOGIN=true

# --- Telegram import (routes/telegram.ts) -----------------------------------
# Lets a user link Telegram and pull media into DarkDrive. Both values below
# are required for ANY of it to work — including the bot — because we talk
# MTProto rather than the HTTP Bot API (no 20MB download cap, so multi-GB
# videos import fine). Leave them blank to disable the feature entirely.
#
# Get them from https://my.telegram.org/apps:
#   log in with your phone number -> "API development tools" -> create an app
#   (any name/platform). It gives you an api_id (number) and api_hash (hex).
# These identify the *application*, not a user — one pair serves every user.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional, on top of the two above — runs a Telegram bot that imports
# whatever's forwarded/sent to it in real time, as an alternative to the
# Saved-Messages pull. Get the token from @BotFather (/newbot).
# Without TELEGRAM_API_ID/HASH set, a token alone does nothing and the API
# logs a warning at startup.
TELEGRAM_BOT_TOKEN=
