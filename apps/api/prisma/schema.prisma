// Prisma schema for DarkDrive
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  googleId     String   @unique
  email        String   @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  role                  UserRole  @default(USER)
  storageQuotaBytes     BigInt    @default(1073741824)
  upgradeRequestedAt    DateTime?
  upgradeRequestedBytes BigInt?
  disabledAt            DateTime?

  rootFolderId String?  @unique
  rootFolder   Folder?  @relation("UserRoot", fields: [rootFolderId], references: [id])

  folders      Folder[]  @relation("FolderOwner")
  files        File[]    @relation("FileOwner")
  spaces        Space[]   @relation("SpaceOwner")
  memberships   SpaceMember[]
  shares        Share[]
  fileAccesses  FileAccess[]
  loginEvents   LoginEvent[]
  notifications Notification[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Discriminator the client uses to pick an icon/label — see
  // apps/api/src/lib/notify.ts for the fixed set of values in use.
  type      String
  title     String
  body      String?
  // Client-side path to navigate to when the notification is clicked, e.g.
  // "/drive/<folderId>". Null for notifications with nowhere to go.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model FileAccess {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  action     String
  accessedAt DateTime @default(now())

  @@index([userId, accessedAt])
  @@index([userId, fileId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  color     String?
  ownerId   String
  owner     User     @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderChildren")
  files     File[]
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  thumbnailKey String?
  isHidden  Boolean  @default(false)
  isTrashed Boolean  @default(false)
  isStarred Boolean  @default(false)
  // System-level (admin) recycle bin. When a user permanently deletes an item
  // from their own bin, it is not destroyed — it is stamped with `deletedAt` and
  // retained here so an admin can restore or purge it. `deletedById` records who
  // triggered the deletion. A non-null `deletedAt` always implies
  // `isTrashed = true`, so deleted items stay excluded from every normal listing.
  deletedAt   DateTime?
  deletedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rootOf    User?    @relation("UserRoot")
  spaceRootOf Space? @relation("SpaceRoot")
  shares    Share[]
  shortcuts FileShortcut[] @relation("FolderShortcuts")

  @@index([ownerId, parentId])
  @@index([spaceId, parentId])
  @@index([deletedAt])
}

model File {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  owner      User     @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folderId   String
  folder     Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  spaceId    String?
  space      Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  size       BigInt
  mimeType   String
  storageKey String   @unique
  // Storage key of the generated preview thumbnail (a small JPEG), or null if
  // none exists yet. Populated by the thumbnail pipeline (see lib/thumbnails).
  thumbnailKey String?
  // Generation outcome: "ready", "failed", or "unsupported". Null means not yet
  // attempted. Used to avoid re-running the pipeline on files that can't (or
  // didn't) produce a thumbnail.
  thumbnailState String?
  isHidden   Boolean  @default(false)
  isTrashed  Boolean  @default(false)
  isStarred  Boolean  @default(false)
  // See Folder.deletedAt — admin recycle bin retention for permanently-deleted
  // files. A non-null `deletedAt` always implies `isTrashed = true`.
  deletedAt   DateTime?
  deletedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shares     Share[]
  accesses   FileAccess[]
  shortcuts  FileShortcut[]

  @@index([ownerId, folderId])
  @@index([spaceId, folderId])
  @@index([deletedAt])
}

model Space {
  id           String   @id @default(cuid())
  name         String
  // CSS color (hex or named) used to tint the space in the sidebar and
  // dialog. Null falls back to a neutral default.
  color        String?
  // Storage key pointing to the uploaded logo image. Null means the UI
  // renders the default gradient-with-initial badge.
  logoKey      String?
  // Key from the curated icon set (see apps/web/src/lib/spaceIcons.tsx).
  // Mutually exclusive with logoKey in the UI — if both are set, logoKey
  // wins. Null means no icon selected.
  icon         String?
  ownerId      String
  owner        User     @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  rootFolderId String   @unique
  rootFolder   Folder   @relation("SpaceRoot", fields: [rootFolderId], references: [id])
  // When true, any authenticated DarkDrive user can read the space's contents.
  // Writes are still restricted to the owner and explicit EDITOR members.
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  members      SpaceMember[]
  folders      Folder[]
  files        File[]
}

enum SpaceRole {
  VIEWER
  EDITOR
  ADMIN
}

model SpaceMember {
  id       String    @id @default(cuid())
  spaceId  String
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     SpaceRole @default(EDITOR)
  joinedAt DateTime  @default(now())

  @@unique([spaceId, userId])
}

enum SharePermission {
  VIEW
  EDIT
}

enum ShareResourceType {
  FILE
  FOLDER
}

model Share {
  id           String             @id @default(cuid())
  token        String             @unique
  resourceType ShareResourceType
  permission   SharePermission    @default(VIEW)
  fileId       String?
  file         File?              @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?            @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime?
  passwordHash String?
  createdAt    DateTime           @default(now())

  @@index([createdById])
}

// A "link" of a file into another folder. Uploads into a shared space go into
// the uploader's drive and surface in the space folder via a shortcut, so the
// file's primary home is always the uploader's drive.
model FileShortcut {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId  String
  folder    Folder   @relation("FolderShortcuts", fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fileId, folderId])
  @@index([folderId])
}
