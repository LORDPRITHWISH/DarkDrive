// Prisma schema for DarkDrive
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())

  role                  UserRole  @default(USER)
  storageQuotaBytes     BigInt    @default(1073741824)
  upgradeRequestedAt    DateTime?
  upgradeRequestedBytes BigInt?
  disabledAt            DateTime?

  rootFolderId String? @unique
  rootFolder   Folder? @relation("UserRoot", fields: [rootFolderId], references: [id])

  folders       Folder[]       @relation("FolderOwner")
  files         File[]         @relation("FileOwner")
  spaces        Space[]        @relation("SpaceOwner")
  memberships   SpaceMember[]
  shares        Share[]
  spaceInvites  SpaceInvite[]
  fileAccesses  FileAccess[]
  loginEvents   LoginEvent[]
  notifications Notification[]
  modifiedFiles File[]         @relation("FileLastModifiedBy")
  fileVersions  FileVersion[]
  activityLogs  ActivityLog[]
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Discriminator the client uses to pick an icon/label — see
  // apps/api/src/lib/notify.ts for the fixed set of values in use.
  type      String
  title     String
  body      String?
  // Client-side path to navigate to when the notification is clicked, e.g.
  // "/drive/<folderId>". Null for notifications with nowhere to go.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model FileAccess {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId     String
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  action     String
  accessedAt DateTime @default(now())

  @@index([userId, accessedAt])
  @@index([userId, fileId])
}

// Audit trail of mutations (upload, rename, move, trash, share, ...) on a
// file or folder. Exactly one of fileId/folderId is set. Separate from
// FileAccess, which only ever records view/download reads — merging the two
// would touch that model's existing view-count call sites (me.ts, admin.ts)
// for no benefit, since they only care about action="view"/"download".
model ActivityLog {
  id        String   @id @default(cuid())
  fileId    String?
  file      File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  // Small human-readable snapshot captured at event time, e.g. {from,to} for
  // a rename — the target itself may later be renamed again or deleted, so
  // the log needs its own copy rather than joining live state.
  detail    Json?
  createdAt DateTime @default(now())

  @@index([fileId, createdAt])
  @@index([folderId, createdAt])
  @@index([userId, fileId])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Folder {
  id           String    @id @default(cuid())
  name         String
  color        String?
  ownerId      String
  owner        User      @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]  @relation("FolderChildren")
  files        File[]
  spaceId      String?
  space        Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  thumbnailKey String?
  isHidden     Boolean   @default(false)
  isTrashed    Boolean   @default(false)
  isStarred    Boolean   @default(false)
  // System-level (admin) recycle bin. When a user permanently deletes an item
  // from their own bin, it is not destroyed — it is stamped with `deletedAt` and
  // retained here so an admin can restore or purge it. `deletedById` records who
  // triggered the deletion. A non-null `deletedAt` always implies
  // `isTrashed = true`, so deleted items stay excluded from every normal listing.
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rootOf       User?          @relation("UserRoot")
  spaceRootOf  Space?         @relation("SpaceRoot")
  shares       Share[]
  shortcuts    FileShortcut[] @relation("FolderShortcuts")
  activityLogs ActivityLog[]

  @@index([ownerId, parentId])
  @@index([spaceId, parentId])
  @@index([deletedAt])
}

model File {
  id                  String    @id @default(cuid())
  name                String
  ownerId             String
  owner               User      @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folderId            String
  folder              Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  spaceId             String?
  space               Space?    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  size                BigInt
  mimeType            String
  storageKey          String    @unique
  // Storage key of the generated preview thumbnail (a small JPEG), or null if
  // none exists yet. Populated by the thumbnail pipeline (see lib/thumbnails).
  thumbnailKey        String?
  // Generation outcome: "ready", "failed", or "unsupported". Null means not yet
  // attempted. Used to avoid re-running the pipeline on files that can't (or
  // didn't) produce a thumbnail.
  thumbnailState      String?
  // Container stream index of the audio track to play by default, set once
  // from the player/properties panel so multi-audio files (dual-audio rips,
  // commentary tracks) don't need reselecting on every open. Null = the
  // source's own default track.
  audioTrackIndex     Int?
  // Playback position in seconds, saved periodically while a video plays so
  // reopening it resumes where the user left off. Null = start from the top
  // (never played, or finished — see lib/thumbnails' onProgress(0) on `ended`).
  playbackPositionSec Float?
  // Storage key of the generated scrubbing-preview sprite sheet (a grid of
  // JPEG frames) for the seek bar, or null if none exists yet. `storyboardMeta`
  // holds the grid layout needed to slice it (interval/cols/rows/tileW/tileH).
  // See lib/thumbnails' storyboard generation.
  storyboardKey       String?
  storyboardState     String?
  storyboardMeta      Json?
  isHidden            Boolean   @default(false)
  isTrashed           Boolean   @default(false)
  isStarred           Boolean   @default(false)
  // Free-form user labels for organizing/filtering. No separate tag table —
  // there's no cross-file tag metadata (color, etc.) to justify one.
  tags                String[]  @default([])
  // See Folder.deletedAt — admin recycle bin retention for permanently-deleted
  // files. A non-null `deletedAt` always implies `isTrashed = true`.
  deletedAt           DateTime?
  deletedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Who uploaded the currently-live content (via "upload new version"). Null
  // means the content is still the original upload, so the author is just
  // `owner`. Kept separate from `owner`, which never changes on a version
  // swap, so past FileVersion rows can be attributed to whoever actually
  // authored that content at archive time — see files.ts's replace handler.
  lastModifiedById String?
  lastModifiedBy   User?   @relation("FileLastModifiedBy", fields: [lastModifiedById], references: [id], onDelete: SetNull)

  shares       Share[]
  accesses     FileAccess[]
  shortcuts    FileShortcut[]
  versions     FileVersion[]
  activityLogs ActivityLog[]

  @@index([ownerId, folderId])
  @@index([spaceId, folderId])
  @@index([deletedAt])
}

// A superseded content blob for a File, kept so a previous "upload new
// version" can be downloaded or restored. Only past content lives here — the
// live content stays on File.storageKey/size/mimeType so every other read
// path (streaming, thumbnails, zip) is untouched.
model FileVersion {
  id          String   @id @default(cuid())
  fileId      String
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  storageKey  String
  size        BigInt
  mimeType    String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([fileId, createdAt])
}

model Space {
  id           String   @id @default(cuid())
  name         String
  // CSS color (hex or named) used to tint the space in the sidebar and
  // dialog. Null falls back to a neutral default.
  color        String?
  // Storage key pointing to the uploaded logo image. Null means the UI
  // renders the default gradient-with-initial badge.
  logoKey      String?
  // Key from the curated icon set (see apps/web/src/lib/spaceIcons.tsx).
  // Mutually exclusive with logoKey in the UI — if both are set, logoKey
  // wins. Null means no icon selected.
  icon         String?
  ownerId      String
  owner        User     @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  rootFolderId String   @unique
  rootFolder   Folder   @relation("SpaceRoot", fields: [rootFolderId], references: [id])
  // When true, any authenticated DarkDrive user can read the space's contents.
  // Writes are still restricted to the owner and explicit EDITOR members.
  isPublic     Boolean  @default(false)
  // Whether the owner has pinned this space to their own sidebar. Mirrors
  // SpaceMember.pinned, which serves the same purpose for joined members —
  // owners have no SpaceMember row so they need their own copy of the flag.
  pinned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  members SpaceMember[]
  folders Folder[]
  files   File[]
  invites SpaceInvite[]
}

enum SpaceRole {
  VIEWER
  EDITOR
  ADMIN
}

// A shareable invite link — anyone with the token and a DarkDrive account
// can join the space at the given role, subject to the optional expiry and
// use-limit. Distinct from Space.isPublic: this grants access to spaces that
// aren't publicly discoverable, to whoever holds the link.
model SpaceInvite {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  token       String    @unique
  role        SpaceRole @default(VIEWER)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  // Null means no limit / never expires.
  maxUses     Int?
  useCount    Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([spaceId])
}

model SpaceMember {
  id                String    @id @default(cuid())
  spaceId           String
  space             Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              SpaceRole @default(EDITOR)
  // Whether this member has pinned the space to their own sidebar. Only
  // meaningful for non-owner members — owners always see their own spaces.
  pinned            Boolean   @default(false)
  // Set when a VIEWER asks the owner to be promoted to EDITOR (upload
  // rights). Null when there's no pending request — cleared on approve/deny.
  editorRequestedAt DateTime?
  joinedAt          DateTime  @default(now())

  @@unique([spaceId, userId])
}

enum SharePermission {
  VIEW
  EDIT
}

enum ShareResourceType {
  FILE
  FOLDER
}

model Share {
  id           String            @id @default(cuid())
  token        String            @unique
  resourceType ShareResourceType
  permission   SharePermission   @default(VIEW)
  fileId       String?
  file         File?             @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?           @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime?
  passwordHash String?
  createdAt    DateTime          @default(now())

  @@index([createdById])
}

// A "link" of a file into another folder. Uploads into a shared space go into
// the uploader's drive and surface in the space folder via a shortcut, so the
// file's primary home is always the uploader's drive.
model FileShortcut {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folderId  String
  folder    Folder   @relation("FolderShortcuts", fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([fileId, folderId])
  @@index([folderId])
}
