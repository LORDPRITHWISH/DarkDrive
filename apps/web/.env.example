# Leave blank in dev — Vite proxies /api and /socket.io to the backend.
# Set to the API origin in production, e.g. https://api.example.com
VITE_API_URL=

# The public URL of the frontend application (used for Open Graph tags, etc.)
# e.g., http://localhost:4200 or https://darkdrive.zenux.live
VITE_APP_URL=
